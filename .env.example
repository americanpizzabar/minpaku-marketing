# Turso DB (未設定の場合はデモデータモードで動作します)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# AirROI API (民泊アナリティクスAPI, x-api-keyヘッダ認証)
AIRROI_API_KEY=your-airroi-api-key
AIRROI_API_BASE_URL=https://api.airroi.com
# 検索半径 (マイル) と1エリアあたりの追跡物件数上限
AIRROI_RADIUS_MILES=3
AIRROI_MAX_LISTINGS_PER_AREA=100

# --- APIコスト管理 (検索$0.50/回, 料金カレンダー$0.10/回) ---
# 物件カタログ (エリア検索) の再取得周期。約500物件時: 50回×$0.50=$25/周期
AIRROI_SEARCH_REFRESH_DAYS=30
# 各物件の料金カレンダーの更新周期 (古い物件から順に更新)
AIRROI_RATES_REFRESH_DAYS=14
# 1回の同期 (日次Cron/手動ボタン) で料金カレンダーを取得する最大物件数
# 月額目安 ≈ 追跡物件数 × $0.10 × 30 ÷ RATES_REFRESH_DAYS + カタログ費
AIRROI_DAILY_RATES_CALLS=40

# Vercel Cron 認証用シークレット (Vercelが自動でAuthorizationヘッダに付与)
CRON_SECRET=generate-a-random-secret

# 管理画面の簡易Basic認証 (両方設定した場合のみ有効)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Turso DB (未設定の場合はデモデータモードで動作します)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# AirROI API (民泊アナリティクスAPI)
AIRROI_API_KEY=your-airroi-api-key
AIRROI_API_BASE_URL=https://api.airroi.com/v1

# Vercel Cron 認証用シークレット (Vercelが自動でAuthorizationヘッダに付与)
CRON_SECRET=generate-a-random-secret

# 管理画面の簡易Basic認証 (両方設定した場合のみ有効)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
